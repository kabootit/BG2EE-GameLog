{
  "tasks": {
    "play": "deno run --allow-env --allow-run=script --allow-read --allow-write src/play.ts",
    "serve": "deno run --allow-env --allow-read --allow-write --allow-net=127.0.0.1 src/serve.ts",
    "import": "deno run --allow-env --allow-read --allow-write src/import.ts",
    "patterns": "deno run --allow-env --allow-read --allow-write src/patterns.ts",
    "install-mod": "deno run --allow-env --allow-run --allow-read --allow-write src/install_mod.ts",
    "check": "deno check src/*.ts",
    "lint": "deno lint && deno check src/*.ts && deno run --allow-env --allow-read src/lint.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
